// Cloudflare Workers Static Assets – endast statiska filer (ingen serverkod). Data ligger i Supabase EU (Stockholm).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "styrka-staging",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false }
}
